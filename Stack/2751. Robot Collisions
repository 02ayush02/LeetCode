class Solution {
public:
    vector<int> survivedRobotsHealths(vector<int>& positions, vector<int>& healths, string directions) {
        int n = positions.size();
        vector<int>order(n);
        iota(order.begin(), order.end(), 0);

        auto func = [&](int a, int b) {
            return positions[a] < positions[b];
        };

        sort(order.begin(), order.end(), func);

        // for (auto it : order) {
        //     cout << it << " ";
        // }

        stack<int> st;  // inserting the original index in the stack means 
                        // according to the positions
                        // ok cool

        for (auto it : order) {
            if (directions[it] == 'R') {
                st.push(it);
            } else {
                while(!st.empty()) {
                    int index = st.top();

                    if (healths[index] < healths[it]) {
                        st.pop();
                        healths[index] = 0;
                        healths[it] -= 1;
                    } else if (healths[index] > healths[it]) {
                        healths[index] -= 1;
                        healths[it] = 0;
                        break;
                    } else {
                        healths[index] = healths[it] = 0;
                        st.pop();
                        break;
                    }
                }
            }
        }
        vector<int> ans;
        for (auto it : healths) {
            if (it > 0) {
                ans.push_back(it);
            }
        }

        return ans;
    }
};
