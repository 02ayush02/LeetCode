class Solution {
public:
    int maxProductPath(vector<vector<int>>& grid) {
        int n = grid.size(), m = grid[0].size();
        // {maxi, mini} 
        using use = pair<long long, long long>;
        const int mod = 1e9 + 7;
        vector<vector<use>> dp(n, vector<use>(m));
        dp[0][0] = {grid[0][0], grid[0][0]};

        for (int i = 1; i < n; i++) {
            dp[i][0].first = dp[i][0].second = (dp[i - 1][0].first * grid[i][0]);
        }

        for (int j = 1; j < m; j++) {
            dp[0][j].first = dp[0][j].second = (dp[0][j - 1].first * grid[0][j]);
        }

        for (int i = 1; i < n; i++) {
            for (int j = 1; j < m; j++) {
                long long val = grid[i][j];
                long long maxVal = max(dp[i - 1][j].first, dp[i][j - 1].first);
                long long minVal = min(dp[i - 1][j].second, dp[i][j - 1].second);
                if (grid[i][j] < 0) {
                    dp[i][j].first = (val * minVal);
                    dp[i][j].second = (val * maxVal);
                } else {
                    dp[i][j].first = (val * maxVal);
                    dp[i][j].second = (val * minVal);
                }
            }
        }

        return dp[n - 1][m - 1].first < 0 ? -1 : dp[n - 1][m - 1].first % mod; 
    }
};
