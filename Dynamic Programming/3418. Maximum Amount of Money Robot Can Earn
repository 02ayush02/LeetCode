class Solution {
public:
    int n, m;
    const int neg = -1e9 + 7;
    int solve(int i, int j, int left, vector<vector<int>>& coins, vector<vector<vector<int>>>& dp) {
        if (i >= n || j >= m) return INT_MIN;

        if (i == n - 1 && j == m - 1) {
            if (coins[i][j] >= 0) {
                return coins[i][j];
            } else if (left > 0) {
                return 0;
            }
            return coins[i][j];
        }

        if (dp[i][j][left] != neg) return dp[i][j][left];

        int down = solve(i + 1, j, left, coins, dp);
        int right = solve(i, j + 1, left, coins, dp);

        int best = max(down, right);

        if (best == INT_MIN) return dp[i][j][left] = INT_MIN;

        if (coins[i][j] >= 0) {
            return dp[i][j][left] = coins[i][j] + best;
        }

        int takeNeg = coins[i][j] + best;

        int convert = INT_MIN;
        if (left > 0) {
            int down2 = solve(i + 1, j, left - 1, coins, dp);
            int right2 = solve(i, j + 1, left - 1, coins, dp);

            int best2 = max(down2, right2);
            if (best2 != INT_MIN) {
                convert = 0 + best2;
            }
        }

        return dp[i][j][left] = max(takeNeg, convert);
    }

    int maximumAmount(vector<vector<int>>& coins) {
        n = coins.size();
        m = coins[0].size();

        vector<vector<vector<int>>> dp(n, vector<vector<int>>(m, vector<int>(3, neg)));

        return solve(0, 0, 2, coins, dp);
    }
};
