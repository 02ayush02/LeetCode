class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        vector<int> temp = nums;
        int n = nums.size();

        for (int i = 0; i < n; i++) {
            temp[i] = abs(temp[i]);
        }
  
        sort(temp.begin(), temp.end());

        long long minus = 0, plus = 0;
        for (int i = 0; i < n / 2; i++) {
            minus += (temp[i] * temp[i]);
        }
        for (int i = n / 2; i < n; i++) {
            plus += (temp[i] * temp[i]);
        }

        return plus - minus;
    }
};
